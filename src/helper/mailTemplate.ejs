<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Detection Intelligence Report - RakshaVision</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 700px;
      margin: auto;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    }

    .header {
      background: #1f2a36;
      color: #fff;
      text-align: center;
      padding: 20px;
    }

    .content {
      padding: 20px;
      color: #333;
    }

    .badge {
      display: inline-block;
      background: #0d6efd;
      color: #fff;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      margin-right: 6px;
    }

    .summary {
      background: #f1f3f5;
      padding: 15px;
      border-radius: 6px;
      margin: 20px 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 14px;
    }

    th,
    td {
      border: 1px solid #dee2e6;
      padding: 8px;
      text-align: center;
    }

    th {
      background: #e9ecef;
    }

    .footer {
      text-align: center;
      font-size: 12px;
      color: #777;
      padding: 20px;
    }

    img.preview {
      width: 120px;
      border-radius: 6px;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h1>RakshaVision</h1>
      <p>AI-Powered Tactical Asset Intelligence</p>
    </div>

    <div class="content">
      <h2>Detection Intelligence Report</h2>

      <p><strong>Upload ID:</strong>
        <%= upload_id %>
      </p>
      <p><strong>Processed At:</strong>
        <%= processed_at %>
      </p>

      <div class="summary">
        <p><strong>Total Events:</strong>
          <%= summary.total_events %>
        </p>
        <p>
          <% Object.keys(summary.classes).forEach(cls=> { %>
            <span class="badge">
              <%= cls %>: <%= summary.classes[cls] %>
            </span>
            <% }) %>
        </p>
      </div>

      <h3>Detected Events</h3>
      <table>
        <thead>
          <tr>
            <th>Class</th>
            <th>Confidence</th>
            <th>First Seen (s)</th>
            <th>Frame</th>
            <th>Preview</th>
          </tr>
        </thead>
        <tbody>
          <% detected_events.forEach(e=> { %>
            <tr>
              <td>
                <%= e.class %>
              </td>
              <td>
                <%= (e.confidence * 100).toFixed(2) %>%
              </td>
              <td>
                <%= e.first_seen %>
              </td>
              <td>
                <%= e.frame_indices[0] %>
              </td>
              <td>
                <img src="<%= baseUrl %>/<%= e.best_frame_url.replace('public/', '') %>" class="preview" />
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>

      <p style="margin-top:20px;">
        <strong>Detected Video:</strong><br />
        <a href="<%= baseUrl %>/<%= detected_video_url.replace('public/', '') %>">
          View Processed Video
        </a>
      </p>
    </div>

    <div class="footer">
      <p>Made with ♥ by NovaCops</p>
      <p>RakshaVision © <%= new Date().getFullYear() %>
      </p>
    </div>
  </div>
</body>

</html>